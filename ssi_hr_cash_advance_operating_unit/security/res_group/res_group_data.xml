<odoo>
<!-- Data Ownership -->
<record id="hr_cash_advance_ou_group" model="res.groups">
    <field name="name">Operating Unit</field>
    <field
            name="category_id"
            ref="ssi_hr_cash_advance.hr_cash_advance_data_ownership_module_category"
        />
</record>

<record id="ssi_hr_cash_advance.hr_cash_advance_company_group" model="res.groups">
    <field name="name">Company</field>
    <field
            name="category_id"
            ref="ssi_hr_cash_advance.hr_cash_advance_data_ownership_module_category"
        />
    <field name="implied_ids" eval="[(4, ref('hr_cash_advance_ou_group'))]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

<record id="hr_cash_advance_settlement_ou_group" model="res.groups">
    <field name="name">Operating Unit</field>
    <field
            name="category_id"
            ref="ssi_hr_cash_advance.hr_cash_advance_settlement_data_ownership_module_category"
        />
</record>

<record
        id="ssi_hr_cash_advance.hr_cash_advance_settlement_company_group"
        model="res.groups"
    >
    <field name="name">Company</field>
    <field
            name="category_id"
            ref="ssi_hr_cash_advance.hr_cash_advance_settlement_data_ownership_module_category"
        />
    <field
            name="implied_ids"
            eval="[(4, ref('hr_cash_advance_settlement_ou_group'))]"
        />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>
</odoo>
